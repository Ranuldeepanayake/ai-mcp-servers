// This file defines the reproducible Python environment used by VS Code Dev Containers.
// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "AWS MCP Server",
  // The image supplies Python and common development tools; uv installs project dependencies.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install uv && uv sync --dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  // Streamable HTTP listens on this port inside the container and is published on localhost.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AWS MCP Server",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    // Read-only AWS CLI configuration; credentials remain on the host.
    "source=${localEnv:USERPROFILE}/.aws,target=/home/vscode/.aws,type=bind,readonly"
  ],
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "AWS_SDK_LOAD_CONFIG": "1",
    // Forward the selected host profile/region when they are set; the AWS files remain read-only.
    "AWS_PROFILE": "${localEnv:AWS_PROFILE}",
    "AWS_REGION": "${localEnv:AWS_REGION}",
    "AWS_DEFAULT_REGION": "${localEnv:AWS_DEFAULT_REGION}",
    // Bind to all container interfaces so Docker/VS Code can forward port 8000.
    "MCP_TRANSPORT": "streamable-http",
    "MCP_HOST": "0.0.0.0",
    "MCP_PORT": "8000"
  },
  "remoteUser": "vscode",
  "features": {}
}
